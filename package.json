{
  "name": "signbridge-isl",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, real-time sign recognition and gesture-to-speech accessibility platform powered by MediaPipe and TensorFlow.js.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "models:download": "node scripts/download-models.mjs",
    "models:verify": "node scripts/verify-models.mjs",
    "benchmark": "vitest run --config vitest.benchmark.config.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tensorflow/tfjs": "^4.22.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.7",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "sign-language",
    "indian-sign-language",
    "computer-vision",
    "mediapipe",
    "tensorflow-js",
    "accessibility",
    "gesture-recognition",
    "machine-learning",
    "open-source"
  ],
  "engines": {
    "node": ">=20"
  }
}
